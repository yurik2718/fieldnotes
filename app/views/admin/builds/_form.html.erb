<%# locals: (build:) %>
<%= admin_error_list(build) %>

<%= form_with model: [:admin, build] do |f| %>
  <%= admin_card do %>
    <div class="field">
      <%= f.label :title, class: "label" %>
      <%= f.text_field :title, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :description, class: "label" %>
      <%= f.text_area :description, rows: 3, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :url, class: "label" %>
      <%= f.url_field :url, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :icon_emoji, class: "label" %>
      <%= f.text_field :icon_emoji, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :status, class: "label" %>
      <%= f.select :status, Build.statuses.keys, {}, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :kind, class: "label" %>
      <%= f.select :kind, Build.kinds.keys, {}, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :position, class: "label" %>
      <%= f.number_field :position, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :started_on, class: "label" %>
      <%= f.date_field :started_on, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :finished_on, class: "label" %>
      <%= f.date_field :finished_on, class: "input" %>
    </div>
  <% end %>

  <%= f.submit "Save", class: "btn btn--primary" %>
<% end %>
