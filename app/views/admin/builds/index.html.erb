<% content_for :title, "Builds" %>

<%= admin_toolbar(title: "Builds") do %>
  <%= link_to "New Build", new_admin_build_path, class: "btn btn--primary" %>
<% end %>

<% if @builds.any? %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Kind</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @builds.each do |build| %>
        <tr>
          <td>
            <%= link_to build.title, edit_admin_build_path(build), class: "txt-accent txt-medium" %>
          </td>
          <td class="txt-subtle"><%= build.kind %></td>
          <td><%= badge(build.status) %></td>
          <td></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state">
    No builds yet. <%= link_to "Add your first one", new_admin_build_path, class: "txt-accent" %>
  </p>
<% end %>
