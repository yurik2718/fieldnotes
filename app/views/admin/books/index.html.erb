<% content_for :title, "Books" %>

<%= admin_toolbar(title: "Books") do %>
  <%= link_to "New Book", new_admin_book_path, class: "btn btn--primary" %>
<% end %>

<% if @books.any? %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Author</th>
        <th>Status</th>
        <th>Rating</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @books.each do |book| %>
        <tr>
          <td>
            <%= link_to book.title, edit_admin_book_path(book), class: "txt-accent txt-medium" %>
          </td>
          <td class="txt-subtle"><%= book.author %></td>
          <td><%= badge(book.status) %></td>
          <td><%= book.rating ? "★" * book.rating : "—" %></td>
          <td></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state">
    No books yet. <%= link_to "Add your first one", new_admin_book_path, class: "txt-accent" %>
  </p>
<% end %>
