<% content_for :title, "Settings" %>

<%= admin_toolbar(title: "Settings") %>
<%= admin_error_list(@setting) %>

<%= form_with model: @setting, url: admin_settings_path, method: :patch do |f| %>
  <%= admin_card(title: "Watermark") do %>
    <div class="field">
      <div class="flex align-center gap-half">
        <%= f.check_box :watermark_enabled, class: "checkbox" %>
        <%= f.label :watermark_enabled, "Enable watermark on Field photos", class: "txt-small" %>
      </div>
    </div>
    <div class="field">
      <%= f.label :watermark, "Watermark image (PNG with transparency)", class: "label" %>
      <%= f.file_field :watermark, accept: "image/png", class: "input--file" %>
      <% if @setting.watermark.attached? %>
        <p class="hint">Current: <%= @setting.watermark.filename %> — upload a new file to replace it</p>
        <div class="watermark-preview">
          <%= image_tag @setting.watermark, alt: "Watermark preview" %>
        </div>
      <% end %>
    </div>
    <div class="field">
      <%= f.label :watermark_position, "Position", class: "label" %>
      <%= f.select :watermark_position, [["Bottom right", "bottom_right"], ["Bottom left", "bottom_left"], ["Top right", "top_right"], ["Top left", "top_left"]], {}, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :watermark_opacity, "Opacity (10–80%)", class: "label" %>
      <%= f.number_field :watermark_opacity, min: 10, max: 80, step: 5, class: "input" %>
    </div>
  <% end %>

  <%= f.submit "Save settings", class: "btn btn--primary margin-block-2x" %>
<% end %>

<%= admin_card(title: "Regenerate watermarks") do %>
  <p class="hint margin-block-half">Apply current watermark settings to all Field photos. Runs in background.</p>
  <%= button_to "Regenerate all watermarks",
        admin_settings_watermark_regeneration_path,
        method: :post,
        class: "btn",
        data: { turbo_confirm: "This will re-process all Field photos in the background. Continue?" } %>
<% end %>
