<%# locals: (series:) %>
<div id="new_field_item" class="panel">
  <h2>Add item</h2>
  <%= form_with model: [ series, FieldItem.new ], url: admin_field_field_items_path(series) do |f| %>
    <div class="field">
      <%= f.label :kind, class: "label" %>
      <%= f.select :kind, FieldItem.kinds.keys, {}, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :photo, class: "label" %>
      <%= f.file_field :photo, accept: "image/*", class: "input--file" %>
    </div>
    <div class="field">
      <%= f.label :caption, class: "label" %>
      <%= f.text_field :caption, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :youtube_url, "YouTube URL (for videos)", class: "label" %>
      <%= f.url_field :youtube_url, class: "input" %>
    </div>
    <%= f.submit "Add item", class: "btn btn--primary" %>
  <% end %>
</div>
