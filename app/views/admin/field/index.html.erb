<% content_for :title, "Field Series" %>

<%= admin_toolbar(title: "Field Series") do %>
  <%= link_to "New Series", new_admin_field_path, class: "btn btn--primary" %>
<% end %>

<% if @series.any? %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Kind</th>
        <th>Location</th>
        <th>Date</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @series.each do |s| %>
        <tr>
          <td>
            <%= link_to s.title, admin_field_path(s), class: "txt-accent txt-medium" %>
          </td>
          <td class="txt-subtle"><%= s.kind %></td>
          <td class="txt-subtle"><%= s.location %></td>
          <td class="txt-subtle"><%= s.taken_on&.strftime("%b %d, %Y") %></td>
          <td>
            <%= link_to "Edit", edit_admin_field_path(s), class: "txt-small txt-subtle" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state">
    No field series yet. <%= link_to "Create your first one", new_admin_field_path, class: "txt-accent" %>
  </p>
<% end %>
