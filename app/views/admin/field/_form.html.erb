<%# locals: (series:) %>
<%= admin_error_list(series) %>

<% url = series.new_record? ? admin_field_index_path : admin_field_path(series) %>
<%= form_with model: [:admin, series], url: url do |f| %>
  <%= admin_card do %>
    <div class="field">
      <%= f.label :cover, class: "label" %>
      <%= f.file_field :cover, accept: "image/*", class: "input--file" %>
      <% if series.cover.attached? %>
        <%= image_tag series.cover.variant(:thumb), class: "cover-preview" %>
      <% end %>
    </div>
    <div class="field">
      <%= f.label :title, class: "label" %>
      <%= f.text_field :title, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :description, class: "label" %>
      <%= f.text_area :description, rows: 3, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :kind, class: "label" %>
      <%= f.select :kind, FieldSeries.kinds.keys, {}, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :location, class: "label" %>
      <%= f.text_field :location, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :taken_on, class: "label" %>
      <%= f.date_field :taken_on, class: "input" %>
    </div>
  <% end %>

  <%= f.submit "Save", class: "btn btn--primary" %>
<% end %>
