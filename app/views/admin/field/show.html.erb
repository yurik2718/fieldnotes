<% content_for :title, @series.title %>

<%= admin_toolbar(title: @series.title) do %>
  <%= link_to "Edit series", edit_admin_field_path(@series), class: "btn" %>
  <%= link_to "View on site", field_path(@series), target: "_blank", class: "btn" %>
<% end %>

<h2 class="txt-large margin-block-half">Items (<%= @series.field_items.size %>)</h2>

<div id="field_items">
  <%= render partial: "admin/field_items/field_item", collection: @series.field_items.ordered %>
</div>

<%= render "admin/field_items/form", series: @series %>
