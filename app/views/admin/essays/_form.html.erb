<%# locals: (essay:) %>
<%= admin_error_list(essay) %>

<%= form_with model: [:admin, essay] do |f| %>
  <%= admin_card do %>
    <div class="field">
      <%= f.label :title, class: "label" %>
      <%= f.text_field :title, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :excerpt, class: "label" %>
      <%= f.text_area :excerpt, rows: 3, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :status, class: "label" %>
      <%= f.select :status, Essay.statuses.keys, {}, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :published_at, class: "label" %>
      <%= f.datetime_local_field :published_at, class: "input" %>
      <p class="hint">Leave blank — will be set automatically when published.</p>
    </div>
    <div class="field">
      <%= f.label :cover, class: "label" %>
      <%= f.file_field :cover, accept: "image/*", class: "input--file" %>
    </div>
  <% end %>

  <%= admin_card(title: "Content") do %>
    <%= f.rich_text_area :content %>
  <% end %>

  <div class="flex align-center gap-half">
    <% if essay.published? %>
      <%= f.submit "Save", class: "btn btn--primary" %>
    <% else %>
      <%= f.submit "Save Draft", class: "btn" %>
      <%= f.submit "Publish", name: "publish", class: "btn btn--primary" %>
    <% end %>
  </div>
<% end %>
