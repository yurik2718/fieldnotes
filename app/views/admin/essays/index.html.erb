<% content_for :title, "Essays" %>

<%= admin_toolbar(title: "Essays") do %>
  <%= link_to "New Essay", new_admin_essay_path, class: "btn btn--primary" %>
<% end %>

<% if @essays.any? %>
  <table class="admin-table">
    <thead>
      <tr>
        <th></th>
        <th>Title</th>
        <th>Status</th>
        <th>Published</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @essays.each do |essay| %>
        <tr>
          <td>
            <% if essay.cover.attached? %>
              <%= image_tag essay.cover, class: "thumb thumb--square" %>
            <% end %>
          </td>
          <td>
            <%= link_to essay.title, edit_admin_essay_path(essay), class: "txt-accent txt-medium" %>
          </td>
          <td><%= badge(essay.status) %></td>
          <td><%= essay.published_at&.strftime("%b %d, %Y") %></td>
          <td>
            <% if essay.published? %>
              <%= link_to "View", essay_path(essay.slug), target: "_blank", class: "txt-small txt-subtle" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state">
    No essays yet. <%= link_to "Write your first one", new_admin_essay_path, class: "txt-accent" %>
  </p>
<% end %>
