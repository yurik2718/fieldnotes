<% content_for :title, "Profile" %>

<%= admin_toolbar(title: "Profile") %>
<%= admin_error_list(@profile) %>

<%= form_with model: @profile, url: admin_profile_path, method: :patch do |f| %>
  <%= admin_card do %>
    <div class="field">
      <%= f.label :name, class: "label" %>
      <%= f.text_field :name, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :bio, "Bio", class: "label" %>
      <%= f.rich_text_area :bio %>
    </div>
    <div class="field">
      <%= f.label :avatar, "Avatar", class: "label" %>
      <%= f.file_field :avatar, accept: "image/*", class: "input--file" %>
      <% if @profile.avatar.attached? %>
        <p class="hint">Current: <%= @profile.avatar.filename %> — upload a new file to replace</p>
        <%= image_tag @profile.avatar, alt: "Avatar", class: "avatar-preview" %>
      <% end %>
    </div>
  <% end %>

  <%= f.submit "Save", class: "btn btn--primary" %>
<% end %>
