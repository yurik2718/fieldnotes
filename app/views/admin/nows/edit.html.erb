<% content_for :title, "Now" %>

<%= admin_toolbar(title: "Now") do %>
  <%= link_to "View on site", now_path, target: "_blank", class: "btn" %>
<% end %>

<%= admin_card do %>
  <%= form_with model: @now_entry, url: admin_now_path, method: :patch do |f| %>
    <div class="field">
      <%= f.rich_text_area :body %>
      <p class="hint">Each update creates a new entry. Previous versions are kept as history.</p>
    </div>
    <div class="field">
      <%= f.label :location, class: "label" %>
      <%= f.text_field :location, placeholder: "e.g. Bali, Indonesia", class: "input" %>
    </div>
    <%= f.submit "Update", class: "btn btn--primary" %>
  <% end %>
<% end %>

<% if @previous_entries.any? %>
  <h2 class="txt-large margin-block-half">Previous entries</h2>
  <% @previous_entries.each do |entry| %>
    <div class="panel panel--compact">
      <p class="txt-x-small txt-subtle">
        <%= entry.published_at.strftime("%b %d, %Y at %H:%M") %>
        <% if entry.location.present? %>
          · 📍 <%= entry.location %>
        <% end %>
      </p>
    </div>
  <% end %>
<% end %>
