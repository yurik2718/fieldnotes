<% content_for :title, "Quick Post" %>

<div class="center-narrow">
  <h1 class="txt-large margin-block">Quick Post</h1>

  <%= form_with model: @field_series, url: admin_quick_path,
        data: { controller: "upload-preview" } do |f| %>
    <div class="field">
      <%= f.file_field :photos, multiple: true, accept: "image/*", capture: "environment",
          class: "input--file full-width",
          data: { upload_preview_target: "input", action: "change->upload-preview#preview" } %>
    </div>

    <div class="preview-grid margin-block-half" data-upload-preview-target="previews"></div>

    <div class="field">
      <%= f.text_field :title, placeholder: "Title", required: true, class: "input" %>
    </div>

    <div class="field" data-controller="geolocation">
      <%= f.text_field :location, placeholder: "Location (optional)", class: "input",
          data: { geolocation_target: "field" } %>

      <button type="button" data-action="geolocation#detect" class="btn btn--link">
        Use my location
      </button>
    </div>

    <%= f.submit "Save Draft →", class: "btn btn--primary" %>
  <% end %>
</div>
