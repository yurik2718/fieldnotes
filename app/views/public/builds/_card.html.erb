<%# locals: (build:) %>
<article class="card flex flex-column">
  <div class="card__body flex-grow flex flex-column gap-half align-start">
    <div class="card__emoji"><%= build.icon_emoji %></div>
    <div class="flex-grow">
      <h3>
        <% if build.url.present? %>
          <%= link_to build.title, build.url, target: "_blank", rel: "noopener noreferrer" %>
        <% else %>
          <%= build.title %>
        <% end %>
      </h3>
      <% if build.description.present? %>
        <p class="txt-subtle margin-none"><%= build.description %></p>
      <% end %>
    </div>
    <%= badge(build.status) %>
  </div>
</article>
