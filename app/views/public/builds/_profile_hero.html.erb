<%# locals: (profile:) %>
<section class="profile-hero">
  <div class="no-shrink">
    <% if profile.avatar.attached? %>
      <%= image_tag profile.avatar, alt: profile.name, class: "profile-hero__avatar" %>
    <% else %>
      <img src="/avatar.jpg" alt="<%= profile.name %>" class="profile-hero__avatar">
    <% end %>
  </div>
  <div>
    <h2><%= profile.name %></h2>
    <% if profile.bio.present? %>
      <div class="txt-subtle lexxy-content"><%= profile.bio %></div>
    <% end %>
  </div>
</section>
