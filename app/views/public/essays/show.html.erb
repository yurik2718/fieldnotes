<% content_for :title, @essay.title %>
<% content_for :head do %>
  <%= meta_tags(
    title:        @essay.title,
    description:  @essay.excerpt.presence || @essay.title,
    image:        @essay.cover.attached? ? rails_blob_url(@essay.cover) : nil,
    type:         :article,
    published_at: @essay.published_at
  ) %>
<% end %>

<article>
  <h1 class="margin-block-half"><%= @essay.title %></h1>
  <div class="txt-subtle txt-small margin-block-2x">
    <time datetime="<%= @essay.published_at.iso8601 %>">
      <%= @essay.published_at.strftime("%B %d, %Y") %>
    </time>
  </div>
  <div class="lexxy-content">
    <%= @essay.content %>
  </div>
</article>
