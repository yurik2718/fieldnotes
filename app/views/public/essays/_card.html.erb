<%# locals: (essay:) %>
<article class="card margin-block">
  <div class="card__body">
    <h2 class="card__title">
      <%= link_to essay.title, essay_path(essay) %>
    </h2>
    <% if essay.excerpt.present? %>
      <p class="txt-subtle margin-block-half"><%= essay.excerpt %></p>
    <% end %>
    <div class="card__meta">
      <time class="txt-subtle txt-small" datetime="<%= essay.published_at.iso8601 %>">
        <%= essay.published_at.strftime("%B %-d, %Y") %>
      </time>
    </div>
  </div>
</article>
