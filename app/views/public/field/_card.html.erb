<%# locals: (series:) %>
<% cover_photo = series.cover_photo %>
<article class="card">
  <% if cover_photo %>
    <div class="card__media">
      <%= picture_tag(cover_photo, alt: series.title, sizes: "(max-width: 768px) 100vw, 50vw") %>
    </div>
  <% end %>

  <div class="card__body">
    <h2 class="card__title">
      <%= link_to series.title, field_path(series) %>
    </h2>
    <% if series.description.present? %>
      <p class="txt-subtle txt-small margin-block-half"><%= series.description %></p>
    <% end %>
    <div class="card__meta">
      <%= badge(series.kind) %>
      <% if series.location.present? %>
        <span class="txt-subtle txt-small">📍 <%= series.location %></span>
      <% end %>
      <% if series.taken_on.present? %>
        <time class="txt-subtle txt-small" datetime="<%= series.taken_on.iso8601 %>">
          <%= series.taken_on.strftime("%b %Y") %>
        </time>
      <% end %>
    </div>
  </div>
</article>
