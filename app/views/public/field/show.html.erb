<% content_for :title, @series.title %>
<% content_for :main_class, "container--wide" %>
<% content_for :head do %>
  <%= meta_tags(title: @series.title, description: @series.description.presence || @series.title) %>
<% end %>

<nav class="margin-block">
  <%= link_to "← Field", field_index_path, class: "txt-subtle" %>
</nav>

<header class="margin-block-2x">
  <h1 class="margin-block-half"><%= @series.title %></h1>
  <div class="flex align-center gap-half flex-wrap margin-block-half">
    <% if @series.location.present? %>
      <span class="txt-subtle">📍 <%= @series.location %></span>
      <span class="txt-subtle">·</span>
    <% end %>
    <% if @series.taken_on.present? %>
      <time class="txt-subtle" datetime="<%= @series.taken_on.iso8601 %>">
        <%= @series.taken_on.strftime("%B %Y") %>
      </time>
      <span class="txt-subtle">·</span>
    <% end %>
    <%= badge(@series.kind) %>
  </div>
  <% if @series.description.present? %>
    <p class="txt-subtle"><%= @series.description %></p>
  <% end %>
</header>

<div class="gallery">
  <% @series.field_items.ordered.each_with_index do |item, index| %>
    <figure>
      <% if item.photo.attached? %>
        <div class="media-frame">
          <%= picture_tag(
            field_item_photo(item),
            alt:     item.caption.presence || @series.title,
            sizes:   "(max-width: 768px) 100vw, (max-width: 1440px) 95vw, 1392px",
            loading: index.zero? ? "eager" : "lazy"
          ) %>
        </div>
      <% elsif item.youtube_url.present? %>
        <% if (video_id = item.youtube_video_id) %>
          <div class="media-frame media-frame--video">
            <iframe src="https://www.youtube-nocookie.com/embed/<%= video_id %>"
                    title="<%= item.caption.presence || @series.title %>"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"></iframe>
          </div>
        <% end %>
      <% end %>
      <% if item.caption.present? %>
        <figcaption><%= item.caption %></figcaption>
      <% end %>
      <%= render "shared/exif", item: item %>
    </figure>
  <% end %>
</div>
