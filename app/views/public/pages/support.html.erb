<% content_for :title, "Support" %>
<% content_for :head do %>
  <%= meta_tags(title: "Support", description: "Support the essays, photography, and open source work behind Fieldnotes.") %>
<% end %>

<h1 class="margin-block-half">Support</h1>
<p class="txt-subtle margin-block-2x">
  If my essays, photos, or projects have been useful to you, here is how to fuel the next ones.
</p>

<div class="flex flex-column gap">
  <article class="card">
    <div class="card__body">
      <h2 class="card__title"><a href="https://patreon.com/YurikOnRails">Patreon</a></h2>
      <p class="txt-subtle txt-small margin-none">Monthly support for the writing and photography.</p>
    </div>
  </article>

  <article class="card">
    <div class="card__body">
      <h2 class="card__title"><a href="https://boosty.to/YurikOnRails">Boosty</a></h2>
      <p class="txt-subtle txt-small margin-none">Same thing, different platform.</p>
    </div>
  </article>

  <article class="card">
    <div class="card__body">
      <h2 class="card__title"><a href="https://github.com/sponsors/YurikOnRails">GitHub Sponsors</a></h2>
      <p class="txt-subtle txt-small margin-none">Support the open source projects directly.</p>
    </div>
  </article>
</div>
