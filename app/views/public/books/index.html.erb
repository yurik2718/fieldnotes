<% content_for :title, "Reading" %>
<% content_for :main_class, "container--wide" %>
<% content_for :head do %>
  <%= meta_tags(title: "Reading", description: "Books I've read and key ideas from each.") %>
<% end %>

<h1 class="margin-block-2x">Reading</h1>

<% if @reading.any? %>
  <p class="txt-subtle txt-small margin-block-half">Currently reading</p>
  <div class="book-grid margin-block-2x">
    <%= render partial: "public/books/card", collection: @reading, as: :book %>
  </div>
<% end %>

<% if @books.empty? && @reading.empty? %>
  <p class="empty-state">No books yet.</p>
<% else %>
  <div class="book-grid">
    <%= render partial: "public/books/card", collection: @books, as: :book %>
  </div>
<% end %>
