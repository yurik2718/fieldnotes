<%# locals: (book:) %>
<%= link_to book_path(book), class: "book-card" do %>
  <div class="book-cover">
    <% if book.cover_image_url.present? %>
      <img src="<%= book.cover_image_url %>" alt="<%= book.title %>" loading="lazy">
    <% else %>
      <%= render "public/books/placeholder", title: book.title %>
    <% end %>
  </div>
  <div>
    <p class="txt-small txt-medium"><%= book.title %></p>
    <p class="txt-x-small txt-subtle"><%= book.author %></p>
    <% if book.rating %>
      <p class="txt-x-small stars"><%= "★" * book.rating %></p>
    <% end %>
  </div>
<% end %>
