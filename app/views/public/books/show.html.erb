<% content_for :title, @book.title %>
<% content_for :head do %>
  <%= meta_tags(
    title:       "#{@book.title} — #{@book.author}",
    description: @book.key_idea.to_s.truncate(160),
    image:       @book.cover_image_url
  ) %>
<% end %>

<div class="book-hero">
  <div class="book-hero__cover">
    <% if @book.cover_image_url.present? %>
      <img src="<%= @book.cover_image_url %>" alt="<%= @book.title %>">
    <% else %>
      <div class="book-cover">
        <%= render "public/books/placeholder", title: @book.title %>
      </div>
    <% end %>
  </div>

  <div class="flex-grow min-width">
    <header class="margin-block">
      <h1><%= @book.title %></h1>
      <p class="txt-subtle txt-large margin-block-half"><%= @book.author %></p>
      <div class="flex align-center gap-half flex-wrap">
        <% if @book.rating %>
          <span class="stars"><%= "★" * @book.rating %></span>
        <% end %>
        <%= badge(@book.status) %>
        <% if @book.year_read %>
          <span class="txt-subtle txt-small">Read in <%= @book.year_read %></span>
        <% end %>
      </div>
    </header>

    <% if @book.key_idea.present? %>
      <section class="margin-block">
        <h2 class="margin-block-half">Key idea</h2>
        <p class="txt-subtle"><%= @book.key_idea %></p>
      </section>
    <% end %>

    <% if @book.review.present? %>
      <section class="margin-block">
        <h2 class="margin-block-half">Notes & review</h2>
        <div class="lexxy-content"><%= @book.review %></div>
      </section>
    <% end %>

    <p><%= link_to "← Back to reading list", books_path, class: "txt-subtle" %></p>
  </div>
</div>
