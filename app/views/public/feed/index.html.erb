<% content_for :head do %>
  <%= meta_tags(title: "Fieldnotes", description: "Writing on software, technology, and building things.") %>
<% end %>

<h1 class="margin-block-2x">Fieldnotes</h1>

<% if @essays.empty? %>
  <p class="empty-state">No posts yet.</p>
<% else %>
  <%= render partial: "public/essays/card", collection: @essays, as: :essay %>
<% end %>
