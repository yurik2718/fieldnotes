<% content_for :title, "Now" %>
<% content_for :head do %>
  <%= meta_tags(title: "Now", description: "What I'm working on right now.") %>
<% end %>

<h1 class="margin-block-2x">Now</h1>

<% if @current %>
  <div class="lexxy-content margin-block-half"><%= @current.body %></div>
  <p class="txt-subtle txt-small">
    <time datetime="<%= @current.published_at.iso8601 %>">
      Updated <%= @current.published_at.strftime("%B %d, %Y") %>
    </time>
    <% if @current.location.present? %>
      <span>📍 <%= @current.location %></span>
    <% end %>
  </p>
<% end %>

<% if @previous.any? %>
  <section class="history">
    <h2 class="margin-block">Previous entries</h2>
    <% @previous.each do |entry| %>
      <details>
        <summary>
          <%= entry.published_at.strftime("%B %d, %Y") %>
        </summary>
        <div class="lexxy-content history__body"><%= entry.body %></div>
      </details>
    <% end %>
  </section>
<% end %>
