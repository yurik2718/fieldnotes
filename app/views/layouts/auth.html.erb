<!DOCTYPE html>
<html>
  <head>
    <title>Sign in — Fieldnotes</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "lexxy-content", *all_stylesheets, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <main class="center-narrow flex flex-column justify-center">
      <%= render "shared/flash" %>
      <div class="auth-box">
        <%= yield %>
      </div>
    </main>
  </body>
</html>
