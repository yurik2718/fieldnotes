<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title).present? ? "#{content_for(:title)} — Admin" : "Admin — Fieldnotes" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "lexxy-content", *all_stylesheets, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-theme">
    <nav class="admin-nav">
      <span class="admin-nav__brand">Fieldnotes</span>
      <%= admin_nav_link "Essays", admin_essays_path,      controller: "essays" %>
      <%= admin_nav_link "Builds", admin_builds_path,      controller: "builds" %>
      <%= admin_nav_link "Books",  admin_books_path,       controller: "books" %>
      <%= admin_nav_link "Field",  admin_field_index_path, controller: %w[ field field_items ] %>
      <span class="flex-grow"></span>
      <%= link_to "⚡ Quick", new_admin_quick_path, class: "btn btn--primary" %>
      <%= admin_nav_link "Now",      edit_admin_now_path,      controller: "nows" %>
      <%= admin_nav_link "Profile",  edit_admin_profile_path,  controller: "profiles" %>
      <%= admin_nav_link "Settings", edit_admin_settings_path, controller: "settings" %>
      <%= button_to "Sign out", session_path, method: :delete, class: "admin-nav__signout" %>
    </nav>
    <main>
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
