<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title).present? ? "#{content_for(:title)} — Fieldnotes" : "Fieldnotes" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Fieldnotes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% unless content_for?(:head) %>
      <%= meta_tags(title: "Fieldnotes", description: "Writing on software, technology, and building things.") %>
    <% end %>
    <%= yield :head %>

    <%= tag.link rel: "alternate", type: "application/rss+xml", title: "Fieldnotes", href: feed_url(format: :rss) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "lexxy-content", *all_stylesheets, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <nav class="site-header__nav">
        <%= link_to "Fieldnotes", root_path, class: "site-header__brand" %>
        <div class="flex align-center gap-half">
          <%= nav_link "Essays",  essays_path,      controller: "essays" %>
          <%= nav_link "Builds",  builds_path,      controller: "builds" %>
          <%= nav_link "Reading", books_path,       controller: "books" %>
          <%= nav_link "Field",   field_index_path, controller: "field" %>
          <%= nav_link "Now",     now_path,         controller: "now" %>
        </div>
      </nav>
    </header>

    <main class="<%= content_for(:main_class) %>">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <nav>
        <%= link_to "About",   about_path %>
        <%= link_to "Uses",    uses_path %>
        <%= link_to "Contact", contact_path %>
        <%= link_to "Support", support_path %>
        <%= link_to "GitHub",  "https://github.com/YurikOnRails" %>
        <%= link_to "RSS",     feed_path(format: :rss) %>
      </nav>
    </footer>
  </body>
</html>
