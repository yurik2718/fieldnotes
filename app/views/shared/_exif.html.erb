<%# locals: (item:) %>
<% if item.camera_model.present? %>
  <dl class="exif">
    <div><dt>Camera</dt><dd><%= "#{item.camera_make} #{item.camera_model}".strip %></dd></div>
    <% if item.lens %>
      <div><dt>Lens</dt><dd><%= item.lens %></dd></div>
    <% end %>
    <% if item.focal_length %>
      <div><dt>FL</dt><dd><%= item.focal_length %></dd></div>
    <% end %>
    <% if item.aperture %>
      <div><dt>Aperture</dt><dd><%= item.aperture %></dd></div>
    <% end %>
    <% if item.shutter_speed %>
      <div><dt>Shutter</dt><dd><%= item.shutter_speed %></dd></div>
    <% end %>
    <% if item.iso %>
      <div><dt>ISO</dt><dd><%= item.iso %></dd></div>
    <% end %>
    <% if item.taken_at %>
      <div><dt>Date</dt><dd><%= item.taken_at.strftime("%-d %b %Y") %></dd></div>
    <% end %>
  </dl>
<% end %>
